.DS_Store

# hooks/context_size.py is imported rather than run, so Python byte-compiles it
# next to the source the first time a hook fires.
__pycache__/

# OMP takes a lock next to the *resolved* config path, so once
# ~/.omp/agent/config.yml is symlinked here (install.sh step 3e) every write
# drops an empty omp/config.yml.lock into the checkout.
omp/config.yml.lock
