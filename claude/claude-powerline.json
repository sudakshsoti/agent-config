{
  "theme": "custom",
  "display": {
    "style": "minimal",
    "charset": "unicode",
    "colorCompatibility": "auto",
    "autoWrap": true,
    "padding": 1,
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": false,
            "style": "fish"
          },
          "git": {
            "enabled": true,
            "showSha": false,
            "showAheadBehind": false,
            "showWorkingTree": true,
            "showOperation": false,
            "showTag": false,
            "showTimeSinceCommit": false,
            "showStashCount": false,
            "showUpstream": false,
            "showRepoName": true
          },
          "model": {
            "enabled": true
          },
          "session": {
            "enabled": false,
            "type": "tokens"
          },
          "context": {
            "enabled": true,
            "displayStyle": "text",
            "showPercentageOnly": false,
            "percentageMode": "used",
            "autocompactBuffer": 33000,
            "showIcon": true
          },
          "today": {
            "enabled": false,
            "type": "cost",
            "showUnits": true
          },
          "block": {
            "enabled": false,
            "type": "cost",
            "burnType": "cost",
            "displayStyle": "text"
          },
          "weekly": {
            "enabled": false,
            "displayStyle": "text"
          },
          "version": {
            "enabled": false
          },
          "tmux": {
            "enabled": false
          },
          "sessionId": {
            "enabled": false,
            "showIdLabel": true
          },
          "metrics": {
            "enabled": false,
            "showResponseTime": true,
            "showLastResponseTime": true,
            "showDuration": true,
            "showMessageCount": true,
            "showLinesAdded": true,
            "showLinesRemoved": true
          },
          "env": {
            "enabled": false,
            "variable": ""
          },
          "agent": {
            "enabled": false,
            "showLabel": true,
            "showIcon": true
          },
          "thinking": {
            "enabled": true,
            "showEnabled": false,
            "showEffort": true
          },
          "cacheTimer": {
            "enabled": false,
            "displayMode": "elapsed"
          }
        }
      }
    ],
    "showIcons": true
  },
  "colors": {
    "custom": {
      "directory":       { "bg": "transparent", "fg": "#78accf" },
      "git":             { "bg": "transparent", "fg": "#78accf" },
      "model":           { "bg": "transparent", "fg": "#9a9ea1" },
      "session":         { "bg": "transparent", "fg": "#70b4a2" },
      "block":           { "bg": "transparent", "fg": "#70b4a2" },
      "today":           { "bg": "transparent", "fg": "#70b4a2" },
      "weekly":          { "bg": "transparent", "fg": "#70b4a2" },
      "tmux":            { "bg": "transparent", "fg": "#9cad77" },
      "context":         { "bg": "transparent", "fg": "#babec1" },
      "contextWarning":  { "bg": "#382f1d", "fg": "#d2a56d" },
      "contextCritical": { "bg": "#321919", "fg": "#e19796", "bold": true },
      "metrics":         { "bg": "transparent", "fg": "#828689" },
      "cacheTimer":      { "bg": "transparent", "fg": "#828689" },
      "version":         { "bg": "transparent", "fg": "#6d7274" },
      "env":             { "bg": "transparent", "fg": "#c29e70" },
      "agent":           { "bg": "transparent", "fg": "#d598c0" },
      "thinking":        { "bg": "transparent", "fg": "#a89ccf" }
    }
  },
  "budget": {
    "session": {
      "warningThreshold": 80
    },
    "today": {
      "warningThreshold": 80,
      "amount": 50
    },
    "block": {
      "warningThreshold": 80,
      "amount": 15
    }
  },
  "modelContextLimits": {
    "default": 200000,
    "sonnet": 200000,
    "opus": 1000000
  }
}
