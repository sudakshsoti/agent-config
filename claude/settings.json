    "padding": 0,
    "refreshInterval": 10,
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "$HOME/.claude/subagent-statusline.sh",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen"
