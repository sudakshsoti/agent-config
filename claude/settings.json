    "anthropic-skills:domain-modeling": "off",
    "anthropic-skills:emil-design-eng": "off",
    "anthropic-skills:explain-interface": "off",
    "anthropic-skills:find-animation-opportunities": "off",
    "anthropic-skills:geopolitics": "off",
    "anthropic-skills:grill-me": "off",
    "anthropic-skills:grill-with-docs": "off",
    "anthropic-skills:grilling": "off",
    "anthropic-skills:gtd": "off",
    "anthropic-skills:humanizer": "off",
    "anthropic-skills:implement": "off",
