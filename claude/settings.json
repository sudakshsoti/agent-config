    "anthropic-skills:clinical-reasoning": "off",
    "anthropic-skills:code-review": "off",
    "anthropic-skills:codebase-design": "off",
    "anthropic-skills:commit-push": "off",
    "anthropic-skills:design-interface": "off",
    "anthropic-skills:design-strategy": "off",
    "anthropic-skills:design-typography": "off",
    "anthropic-skills:design-visual-system": "off",
