{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna:high",
    "openai-codex/gpt-6-astra:low",
    "openai-codex/gpt-5.6-terra:medium",
    "openai-codex/gpt-5.6-sol:high",
    "opencode-go/deepseek-v4-flash:low",
    "opencode-go/muse-spark-1.3-contributor:minimal"
  ],
  "theme": "kohra",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true
  },
  "tokenSpeed": {
    "colorSlow": "#E19796",
    "colorMedium": "#D2A56D",
    "colorFast": "#A4B776",
    "colorBlazing": "#70B4A2"
  },
  "powerline": {
    "preset": "default",
    "separator": "dot",
    "layout": {
      "left": [
        "model",
        "custom:kohra-thinking",
        "path",
        "git",
        "context_pct",
        "custom:subagents"
      ],
      "right": ["custom:token-speed"],
      "secondary": []
    },
    "customItems": [
      {
        "id": "kohra-thinking",
        "statusKey": "kohra-thinking",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "subagents",
        "statusKey": "subagents",
        "position": "left",
        "color": "thinkingHigh"
      },
      {
        "id": "token-speed",
        "statusKey": "tokenSpeed",
        "position": "right",
        "selfColorize": true
      }
    ]
  },
  "packages": [
    "npm:@tintinweb/pi-subagents@0.16.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.6.0",
    "npm:pi-web-access@0.23.0",
    "npm:pi-lens@4.0.1",
    "npm:flexoki-pi-theme",
    "npm:awesome-pi-themes",
    "npm:pi-markdown-preview",
    "npm:pi-playwright",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-powerline-footer",
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:pi-token-speed",
    "npm:pi-image-paste",
    "npm:pi-blackhole"
  ],
  "lastChangelogVersion": "0.85.1"
}