{
  "defaultProvider": "opencode-go",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "opencode-go/muse-spark-1.3-contributor:xhigh",
    "opencode-go/glm-5.3-flash:high",
    "opencode-go/deepseek-v4.1-flash:high"
  ],
  "theme": "kohra",
  "quietStartup": true,
  "showLastPrompt": false,
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 49152,
    "keepRecentTokens": 32768
  },
  "tokenSpeed": {
    "colors": {
      "slow": "#E19796",
      "medium": "#D2A56D",
      "fast": "#A4B776",
      "blazing": "#70B4A2"
    }
  },
  "powerline": {
    "preset": "default",
    "separator": "dot",
    "layout": {
      "left": [
        "model",
        "custom:kohra-thinking",
        "path",
        "git",
        "context_pct",
        "custom:subagents"
      ],
      "right": [
        "custom:token-speed"
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "kohra-thinking",
        "statusKey": "kohra-thinking",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "subagents",
        "statusKey": "subagents",
        "position": "left",
        "color": "thinkingHigh"
      },
      {
        "id": "token-speed",
        "statusKey": "tokenSpeed",
        "position": "right",
        "selfColorize": true
      }
    ]
  },
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
    "npm:pi-web-access@0.36.0",
    "npm:pi-lens@4.3.0",
    "npm:flexoki-pi-theme",
    "npm:pi-markdown-preview",
    "npm:pi-playwright",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-token-speed",
    "npm:pi-mcp-adapter",
    "npm:@plannotator/pi-extension",
    "npm:pi-simplify",
    "npm:pi-memory",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@quintinshaw/pi-dynamic-workflows"
  ],
  "lastChangelogVersion": "0.85.1",
  "tuiMode": "fullscreen"
}