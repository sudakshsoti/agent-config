{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna:high",
    "opencode-go/deepseek-v4.1-flash:high",
    "openai-codex/gpt-5.6-sol:high",
    "opencode-go/muse-spark-1.3-contributor:minimal"
  ],
  "theme": "kohra",
  "quietStartup": true,
  "showLastPrompt": false,
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 49152,
    "keepRecentTokens": 32768
  },
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.68,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "opencode-go",
      "id": "muse-spark-1.3-contributor",
      "thinking": "low"
    },
    "showWorkerNotifications": true,
    "passive": false,
    "debugLog": false
  },
  "tokenSpeed": {
    "colors": {
      "slow": "#E19796",
      "medium": "#D2A56D",
      "fast": "#A4B776",
      "blazing": "#70B4A2"
    }
  },
  "powerline": {
    "preset": "default",
    "separator": "dot",
    "layout": {
      "left": [
        "model",
        "custom:kohra-thinking",
        "path",
        "git",
        "context_pct",
        "custom:subagents"
      ],
      "right": [
        "custom:token-speed"
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "kohra-thinking",
        "statusKey": "kohra-thinking",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "subagents",
        "statusKey": "subagents",
        "position": "left",
        "color": "thinkingHigh"
      },
      {
        "id": "token-speed",
        "statusKey": "tokenSpeed",
        "position": "right",
        "selfColorize": true
      }
    ]
  },
  "extensions": [
    "-extensions/catastrophe-guard/index.js"
  ],
  "packages": [
    "npm:@tintinweb/pi-subagents@0.19.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.6.0",
    "npm:pi-web-access@0.23.0",
    "npm:pi-lens@4.0.1",
    "npm:flexoki-pi-theme",
    "npm:awesome-pi-themes",
    "npm:pi-markdown-preview",
    "npm:pi-playwright",
    "npm:@juicesharp/rpiv-todo",
    "npm:@ff-labs/pi-fff",
    "npm:pi-token-speed",
    "npm:pi-quiet-activity",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:cc-safety-net",
      "extensions": []
    },
    "git:github.com/elpapi42/pi-observational-memory"
  ],
  "lastChangelogVersion": "0.85.1",
  "tuiMode": "fullscreen"
}