{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna:high",
    "opencode-go/deepseek-v4.1-flash:high",
    "openai-codex/gpt-5.6-sol:high",
    "opencode-go/muse-spark-1.3-contributor:minimal"
  ],
  "theme": "kohra",
  "quietStartup": true,
  "showLastPrompt": false,
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true
  },
  "tokenSpeed": {
    "colors": {
      "slow": "#E19796",
      "medium": "#D2A56D",
      "fast": "#A4B776",
      "blazing": "#70B4A2"
    }
  },
  "powerline": {
    "preset": "default",
    "separator": "dot",
    "layout": {
      "left": [
        "model",
        "custom:kohra-thinking",
        "path",
        "git",
        "context_pct",
        "custom:subagents"
      ],
      "right": [
        "custom:token-speed"
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "kohra-thinking",
        "statusKey": "kohra-thinking",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "subagents",
        "statusKey": "subagents",
        "position": "left",
        "color": "thinkingHigh"
      },
      {
        "id": "token-speed",
        "statusKey": "tokenSpeed",
        "position": "right",
        "selfColorize": true
      }
    ]
  },
  "packages": [
    "npm:@tintinweb/pi-subagents@0.19.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.6.0",
    "npm:pi-web-access@0.23.0",
    "npm:pi-lens@4.0.1",
    "npm:flexoki-pi-theme",
    "npm:awesome-pi-themes",
    "npm:pi-markdown-preview",
    "npm:pi-playwright",
    "npm:@juicesharp/rpiv-todo",
    "npm:@ff-labs/pi-fff",
    "npm:pi-token-speed",
    "npm:pi-blackhole",
    "npm:pi-quiet-activity",
    "npm:pi-mcp-adapter",
    "npm:pi-claude-bridge",
    "npm:cc-safety-net"
  ],
  "lastChangelogVersion": "0.85.1",
  "tuiMode": "fullscreen"
}