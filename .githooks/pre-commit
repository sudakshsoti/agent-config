#!/usr/bin/env bash
# pre-commit — fast checks, wired by `git config core.hooksPath .githooks`
# (install.sh does that). Tracked in the repo rather than written into
# .git/hooks, so it survives a clone and works from a git worktree, where
# .git is a file and has no hooks/ directory of its own.
#
# Only fast checks run here; scripts/check.sh and CI run the full set.
#
# Bypass with `git commit --no-verify` when you genuinely mean to.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
status=0

python3 "$repo_root/scripts/lint-skills.py" "$repo_root" || status=1
echo
python3 "$repo_root/scripts/check-manifest.py" "$repo_root" || status=1
echo
python3 "$repo_root/scripts/check-docs-placement.py" "$repo_root" || status=1
echo
# Scratch HOME: the routing check must judge tracked files, not ~/.pi (#70).
HOME="$(mktemp -d)" XDG_CONFIG_HOME="$(mktemp -d)" \
  python3 "$repo_root/scripts/check-model-routing.py" "$repo_root" || status=1
echo
python3 "$repo_root/scripts/test-apply-json-config.py" || status=1
echo
python3 "$repo_root/scripts/test-seed-mcp-servers.py" || status=1
echo
# Rebuild claude.ai zips from the staged tree and stage them into this commit,
# so dist/ always matches the skills being committed.
if python3 "$repo_root/scripts/build-dist.py" "$repo_root" --from-index; then
  git -C "$repo_root" add -A -- dist || status=1
else
  status=1
fi

if [[ $status -ne 0 ]]; then
  echo
  echo "pre-commit: refusing the commit."
  echo "  frontmatter FAIL   -> fix skills/<name>/SKILL.md (see skills/README.md)"
  echo "  build-dist FAIL    -> fix the skill or distribution.txt"
  echo "  full suite         -> ./scripts/check.sh"
  echo "  bypass             -> git commit --no-verify"
fi

exit $status
